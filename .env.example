# Yerel PostgreSQL (docker compose up -d). Boş bırakılırsa demo modu: veritabanı süreç
# içinde çalışır ve örnek sorularla açılır. Vercel'de boş bırakın.
DATABASE_URL=postgres://questiontotest:questiontotest@localhost:5438/questiontotest

# Yapay zekâ ile soru bulma (Google Gemini, ücretsiz katman yeterli: https://aistudio.google.com/apikey).
# Boş bırakılırsa yalnızca örnek sayfada hazır sonuç gösterilir.
# Bu uç kimlik doğrulaması içermez: anahtarı herkese açık bir dağıtıma eklemeyin.
GEMINI_API_KEY=
